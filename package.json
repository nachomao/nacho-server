{
  "name": "nacho-server",
  "version": "1.0.0",
  "private": true,
  "description": "NachoPanel 服务端 —— 三层架构中的核心控制节点，负责存储业务数据、管理客户端注册与连接、为面板提供 API、下发指令并接收执行结果。",
  "license": "AGPL-3.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/tests/*.test.ts",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
