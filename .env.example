# ------------------------------------------------------------------
# NachoPanel 服务端配置示例
# 复制为 .env 后按需修改。部署脚本会自动生成随机密钥。
# ------------------------------------------------------------------

# HTTP 监听地址与端口
HOST=0.0.0.0
PORT=8443

# 允许访问面板 API 的跨域来源，多个用逗号分隔；* 表示不限制
CORS_ORIGIN=*

# SQLite 数据库文件路径（相对服务端根目录或绝对路径）
DATABASE_PATH=./data/nacho.db

# 面板 API 访问密钥（面板 -> 服务端）。请使用足够随机的强密钥。
PANEL_API_KEY=change-me-panel-api-key

# 客户端注册（入网）密钥（客户端首次注册时校验）
ENROLLMENT_KEY=change-me-enrollment-key

# true 时允许客户端不提供入网密钥注册；生产环境建议仅在部署窗口开启。
ALLOW_OPEN_ENROLLMENT=false

# 反向代理后可显式指定客户端安装与回连使用的外部地址。
PUBLIC_BASE_URL=

# 位于可信反向代理后时开启，允许使用 Forwarded/X-Forwarded-* 计算安装回连地址。
TRUST_PROXY=false

# Windows Agent 发布制品目录。
ARTIFACTS_PATH=./artifacts

# 健康日志 JSON 快照目录。留空时：若设置 ARTIFACTS_PATH 则使用其 health 子目录，
# 否则使用数据库文件同目录下的 health-artifacts。
HEALTH_ARTIFACTS_PATH=

# 客户端心跳超时（秒）。超过该时长未上报则标记为离线。
OFFLINE_THRESHOLD=60

# 日志保留条数上限（超出后自动裁剪最旧日志）
LOG_RETENTION_MAX=100000

# 运行环境
NODE_ENV=production
